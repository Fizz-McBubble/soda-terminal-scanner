<Project>
  <PropertyGroup>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <InstallerArtifactsRoot Condition="'$(InstallerArtifactsRoot)' == '' and '$(SODA_DERIVED_ROOT)' != ''">$(SODA_DERIVED_ROOT)\scanner-installer\</InstallerArtifactsRoot>
    <InstallerArtifactsRoot Condition="'$(InstallerArtifactsRoot)' == ''">F:\AI项目\SodaTerminal\ZZZ-derived\scanner-installer\</InstallerArtifactsRoot>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$([MSBuild]::EnsureTrailingSlash('$(InstallerArtifactsRoot)'))obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$([MSBuild]::EnsureTrailingSlash('$(InstallerArtifactsRoot)'))bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
