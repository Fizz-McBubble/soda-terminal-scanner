<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZZZ-Scanner-Helper</AssemblyName>
    <RootNamespace>ZZZScannerHelper</RootNamespace>
    <Version>2.3.8</Version>
    <!-- Publishing outside the source tree must not make historical local obj/bin outputs compile inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
  </PropertyGroup>

  <Target Name="PruneHelperPublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_HelperPublishSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_HelperPublishSymbols)" TreatErrorsAsWarnings="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="scanFeedback.contract.json" LogicalName="ZZZScannerHelper.ScanFeedbackContract.json" />
    <Compile Include="..\Interop\NativeMethods.cs" Link="Interop\NativeMethods.cs" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ZZZ-Scanner.Next.RegressionTests</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
